{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "sourceMap": true,
    "removeComments": false,
    "stripInternal": true,
    "verbatimModuleSyntax": false,
    // STAGED. The 2.x build hid these behind suppressImplicitAnyIndexErrors, which
    // TypeScript removed in 5.5. Started at 105 errors across 19 files; core.ts is done,
    // 57 remain. Flip to true once the rest are fixed - `npm run typecheck:strict` lists them.
    "noImplicitAny": false,
    "strictNullChecks": false,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "deferred", "test"]
}
