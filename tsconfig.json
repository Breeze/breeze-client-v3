{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "declaration": true,
    "sourceMap": true,
    "removeComments": false,
    "stripInternal": true,
    "verbatimModuleSyntax": false,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist"
  },
  // scripts/docs-entry.ts is the TypeDoc entry point (see its header). It is here so that it
  // is typechecked and so that TypeDoc, which reads this file, can resolve it; tsconfig.build.json
  // narrows include back to src/ so it is not compiled into dist/.
  "include": ["src/**/*.ts", "scripts/docs-entry.ts"],
  "exclude": ["node_modules", "dist", "deferred", "test"]
}
