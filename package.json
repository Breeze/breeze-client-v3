{
  "name": "breeze-client",
  "version": "3.0.0",
  "description": "Breeze data management for JavaScript clients",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Breeze/breeze-client-v3.git"
  },
  "homepage": "https://github.com/Breeze/breeze-client-v3#readme",
  "bugs": {
    "url": "https://github.com/Breeze/breeze-client-v3/issues"
  },
  "author": {
    "name": "IdeaBlade",
    "url": "https://www.ideablade.com/"
  },
  "contributors": [
    "Jay Traband",
    "Steve Schmitt",
    "Marcel Good",
    "Ward Bell"
  ],
  "engines": {
    "node": ">=20"
  },
  "//sideEffects": "Only the entity-graph mixin is imported for its effect (it patches EntityManager.prototype). Every other module's import-time code is needed only when that module's own exports are used. Read the sideEffects section of CHANGES-DEV.md before adding top-level code.",
  "sideEffects": [
    "./dist/mixin-get-entity-graph.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/breeze.d.ts",
      "default": "./dist/breeze.js"
    },
    "./adapter-ajax-fetch": {
      "types": "./dist/adapter-ajax-fetch.d.ts",
      "default": "./dist/adapter-ajax-fetch.js"
    },
    "./adapter-ajax-post": {
      "types": "./dist/adapter-ajax-post.d.ts",
      "default": "./dist/adapter-ajax-post.js"
    },
    "./adapter-data-service-webapi": {
      "types": "./dist/adapter-data-service-webapi.d.ts",
      "default": "./dist/adapter-data-service-webapi.js"
    },
    "./adapter-model-library-backing-store": {
      "types": "./dist/adapter-model-library-backing-store.d.ts",
      "default": "./dist/adapter-model-library-backing-store.js"
    },
    "./adapter-uri-builder-json": {
      "types": "./dist/adapter-uri-builder-json.d.ts",
      "default": "./dist/adapter-uri-builder-json.js"
    },
    "./mixin-get-entity-graph": {
      "types": "./dist/mixin-get-entity-graph.d.ts",
      "default": "./dist/mixin-get-entity-graph.js"
    },
    "./mixin-save-queuing": {
      "types": "./dist/mixin-save-queuing.d.ts",
      "default": "./dist/mixin-save-queuing.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "docs:api": "typedoc",
    "docs:dev": "npm run docs:api && vitepress dev docs",
    "docs:build": "npm run docs:api && vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "typecheck:test": "tsc -p test/tsconfig.json",
    "clean": "rimraf dist",
    "test": "vitest run",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest --config vitest.unit.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "jest-extended": "^7.0.0",
    "playwright": "^1.63.0",
    "rimraf": "^6.0.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typedoc-vitepress-theme": "^1.1.4",
    "typescript": "~5.8.0",
    "vitepress": "^1.6.4",
    "vitest": "^5.0.0"
  },
  "keywords": [
    "breeze",
    "breezejs",
    "spa",
    "data binding",
    "change tracking",
    "query",
    "linq",
    "cache",
    "graph",
    "relational",
    "orm",
    "entity",
    "model",
    "typescript",
    "esm"
  ]
}
